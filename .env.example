# Copiare in .env.local e valorizzare. Su Vercel vanno impostate come
# Environment Variables del progetto (Settings → Environment Variables).

# --- Supabase (obbligatorie) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Serve all'ufficio per invitare utenti, reimpostare password ed eliminare
# account. Senza, l'app ricade sulla registrazione pubblica con password
# temporanea. Da tenere solo lato server: non ha il prefisso NEXT_PUBLIC.
SUPABASE_SERVICE_ROLE_KEY=

# --- Notifiche email via Resend (facoltative) ---
# Senza RESEND_API_KEY l'app funziona lo stesso: le notifiche non partono e
# l'utente vede un avviso che invita ad avvisare a voce.
RESEND_API_KEY=
# Mittente delle notifiche. Richiede il dominio verificato su Resend;
# se assente si usa onboarding@resend.dev, che però consegna solo
# all'indirizzo del titolare dell'account Resend.
RESEND_FROM="Manuten & Clean 2 S.r.l. <noreply@manutenclean.com>"

# --- URL pubblico (facoltativo) ---
# Usato per i link nelle email. Su Vercel viene dedotto in automatico.
NEXT_PUBLIC_SITE_URL=
